# Dedicated valueless Sepolia test account only. Never use mainnet custody credentials.
# Values stay in contracts/.env locally; never paste a private key into chat.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=
# Optional block-explorer verification. Hardhat vars also supports ETHERSCAN_API_KEY.
ETHERSCAN_API_KEY=
# Needed only for the live round-trip script after deployment.
SICARA_TOKEN_ADDRESS=
SICARA_POOL_ADDRESS=
# Internal attested pilot tool; default is read/reconcile verification only.
# SICARA_ISSUANCE_STEP=verify
# Explicit steps: fund (demo liquidity), prepare (120s authorization), register,
# borrow (synthetic test borrower only), recover-borrow (confirmed revert only),
# verify (cold restart, never new broadcast), fund-faucet, claim-faucet.
