# Root application configuration; never use NEXT_PUBLIC_ for database credentials.
# Use the Supabase PostgreSQL transaction pooler URL (port 6543) for the app.
# URL-encode any special characters in the password. Require verified TLS.
# If needed, download the server CA into .local/supabase-ca.crt and append
# &sslrootcert=.local/supabase-ca.crt to both connection URLs.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?sslmode=verify-full
# Use the direct/session pooler connection for migrations (port 5432).
DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Persistent worker uses a dedicated session connection, never the port-6543 pooler.
DATABASE_WORKER_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Optional CA override. Supabase connections use .local/supabase-ca.crt when present.
# DATABASE_SSL_CA_FILE=.local/supabase-ca.crt
# On Vercel, set DATABASE_SSL_CA to the public PEM CA certificate contents
# instead of a file path. Actual newlines or literal \n escapes are accepted.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Do not include a local sslrootcert path in Vercel's DATABASE_URL.
# Exact browser origin, no trailing slash. Use the HTTPS origin when deployed.
SICARA_APP_ORIGIN=http://127.0.0.1:3000

# Persistent custody host only. Never copy these wallet files to a frontend host.
SICARA_ZCASH_WALLET_DIR=.local/zcash/wallet
SICARA_ZCASH_BINARY=.local/zcash/bin/zec-sidecar
SICARA_ADDRESS_VALIDATOR=.local/zcash/native-target/release/sicara-address-check
# Minimum operator-funded cushion beyond outstanding confirmed principal (zatoshis).
SICARA_OPERATOR_RESERVE_ZATS=1000000
# Canonical settlement verification; server-only Sepolia endpoint (never mainnet).
SICARA_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
