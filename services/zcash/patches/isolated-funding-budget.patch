+// Dedicated isolated-funder patch. Ordinary custody binary is unchanged.
+fn isolated_funding_debit_allowed(network: zcash_protocol::consensus::Network, fee: u64, outputs: &[OutputReq]) -> bool {
+    matches!(network, zcash_protocol::consensus::Network::TestNetwork)
+        && outputs.iter().try_fold(fee, |sum, output| sum.checked_add(output.zats)).is_some_and(|total| total <= 1_000_000)
+}
+#[cfg(test)]
+mod sicara_budget_tests {
+    use super::*;
+    #[test]
+    fn total_debit_includes_fee_and_rejects_mainnet_and_overflow() {
+        use zcash_protocol::consensus::Network::{TestNetwork, MainNetwork};
+        let out = |zats| OutputReq { to: String::new(), zats, memo: vec![] };
+        assert!(isolated_funding_debit_allowed(TestNetwork, 10_000, &[out(900_000)]));
+        assert!(isolated_funding_debit_allowed(TestNetwork, 100_000, &[out(900_000)]));
+        assert!(!isolated_funding_debit_allowed(TestNetwork, 100_001, &[out(900_000)]));
+        assert!(!isolated_funding_debit_allowed(MainNetwork, 10_000, &[out(900_000)]));
+        assert!(!isolated_funding_debit_allowed(TestNetwork, 1, &[out(u64::MAX)]));
+        assert!(!isolated_funding_debit_allowed(TestNetwork, 10_000, &[out(500_000),out(500_000)]));
+    }
+}
