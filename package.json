{
  "name": "sicara",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 tests/*.test.ts",
    "fonts": "node scripts/setup-fonts.mjs",
    "zcash:prepare": "node scripts/prepare-zcash.mjs",
    "zcash:spike": "node --import tsx scripts/zcash-spike.ts",
    "contracts:compile": "pnpm --dir contracts compile",
    "contracts:test": "pnpm --dir contracts test",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "zcash:validator": "cargo build --locked --release --manifest-path services/zcash/native/Cargo.toml --target-dir .local/zcash/native-target",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/collateral-worker.ts",
    "test:zcash-native": "pnpm zcash:validator && node --import tsx --test tests/native-address.integration.ts",
    "worker:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/check-worker.ts",
    "worker:funded": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/check-funded-worker.ts",
    "worker:release": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/check-release.ts",
    "privacy:probe": "node --import tsx experiments/private-collateral/probe.ts",
    "privacy:notes": "node --import tsx experiments/private-collateral/note-probe.ts",
    "privacy:chain": "node --import tsx experiments/private-collateral/chain-probe.ts",
    "privacy:lock": "node --import tsx experiments/private-collateral/lock-probe.ts",
    "privacy:prepare": "node --import tsx experiments/private-collateral/prepare-isolated-test.ts",
    "privacy:test": "node --import tsx --test experiments/private-collateral/credentials.test.ts experiments/private-collateral/cosigner-policy.test.ts experiments/private-collateral/binding-math.test.ts experiments/private-collateral/lock-settlement.test.ts",
    "privacy:typecheck": "tsc --noEmit -p experiments/private-collateral/tsconfig.json",
    "privacy:live": "node --import tsx experiments/private-collateral/live-runner.ts",
    "privacy:fund": "node --import tsx experiments/private-collateral/fund-isolated.ts",
    "privacy:funder": "node scripts/prepare-isolated-funder.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "viem": "^2.38.0",
    "wagmi": "^3.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
